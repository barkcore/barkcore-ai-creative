+/* 下層ページ共通（トップと同じデザイン） */
+:root{--base:#0f3f45;--deep:#0a2d32;--ink:#16201f;--paper:#f5f2ec;--brass:#b9a272;--brassd:#8a7440;--en:"Elms Sans",sans-serif;--ja:"Noto Sans JP","Hiragino Kaku Gothic ProN",sans-serif;--serif:"Noto Serif JP","Hiragino Mincho ProN",serif}
+*{box-sizing:border-box;margin:0;padding:0}
+html{scroll-behavior:smooth}
+body{font-family:var(--ja);color:#f5f2ec;background:var(--base);line-height:2;letter-spacing:.06em;-webkit-font-smoothing:antialiased;overflow-x:hidden}
+a{color:inherit;text-decoration:none}
+a:focus-visible,button:focus-visible{outline:3px solid #b9a272;outline-offset:3px}
+.en{font-family:var(--en);font-weight:400;letter-spacing:.08em}
+.skip{position:absolute;left:-999px;top:0;background:#fff;color:#000;padding:8px 14px;z-index:99}.skip:focus{left:8px;top:8px}
+header{position:fixed;inset:0 0 auto 0;z-index:30;display:flex;justify-content:space-between;align-items:center;padding:28px 40px;pointer-events:none}
+header>*{pointer-events:auto}
+.brand{font-family:var(--en);font-weight:600;font-size:34px;letter-spacing:.1em;line-height:1}
+header nav{display:flex;gap:20px;font-family:var(--en);font-size:17px;margin-left:auto;margin-right:40px}
+header nav a{position:relative}
+header nav a::after{content:"";position:absolute;left:0;bottom:-4px;width:100%;height:1px;background:#fff;transform:scaleX(0);transform-origin:left;transition:transform .3s}
+header nav a:hover::after,header nav a:focus-visible::after{transform:scaleX(1)}
+.burger{background:none;border:0;width:48px;height:34px;cursor:pointer;display:none}
+.burger span{display:block;width:100%;height:2px;background:#fff;margin:7px 0;border-radius:2px}
+.burger span:nth-child(2){width:80%;margin-left:20%}
+.in{width:min(86%,980px);margin:0 auto;position:relative;z-index:2}
+.t{background-color:var(--base);color:#f5f2ec;background-image:repeating-linear-gradient(90deg,rgba(255,255,255,.045) 0 1px,transparent 1px 160px),linear-gradient(180deg,rgba(255,255,255,.04),transparent 40%)}
+.w{background-color:var(--paper);color:var(--ink)}
+.sec{position:relative;padding:150px 0 130px}
+.cv{position:absolute;left:0;top:1px;width:100%;height:clamp(50px,8vw,120px);transform:translateY(-100%);display:block;pointer-events:none}
+.t .cv path{fill:var(--base)}.w .cv path{fill:var(--paper)}
+.sub-hero{padding:190px 0 190px}
+.eyebrow{font-size:13px;letter-spacing:.3em;color:var(--brass);margin-bottom:22px}
+.sub-hero h1{font-family:var(--serif);font-weight:500;font-size:clamp(30px,4vw,56px);line-height:1.5;letter-spacing:.1em}
+.sub-hero .lede{margin-top:24px;font-size:16px;opacity:.92}
+.policy .in{max-width:820px}
+.policy h2{font-family:var(--serif);font-weight:500;font-size:clamp(20px,2.2vw,26px);letter-spacing:.08em;margin:56px 0 14px;padding-top:28px;border-top:1px solid rgba(15,63,69,.25);color:var(--base)}
+.policy h2:first-of-type{margin-top:48px}
+.policy p,.policy li{font-size:16px}
+.policy ul{padding-left:1.4em;margin-top:6px}
+.policy dl{border-top:1px solid rgba(15,63,69,.35);margin-top:10px}
+.policy dl>div{display:grid;grid-template-columns:8em 1fr;gap:20px;padding:18px 0;border-bottom:1px solid rgba(15,63,69,.2)}
+.policy dt{font-weight:500;color:var(--brassd);font-size:14px;letter-spacing:.14em}
+.policy a.u{border-bottom:1px solid currentColor}
+.nf{min-height:100svh;display:grid;align-items:center;padding:140px 0}
+.nf h1{font-family:var(--serif);font-weight:500;font-size:clamp(30px,4vw,56px);letter-spacing:.1em;line-height:1.5;margin-bottom:20px}
+.pill{display:inline-flex;align-items:center;justify-content:center;min-width:220px;margin-top:40px;padding:16px 40px;border:1px solid currentColor;border-radius:99px;font-family:var(--en);font-size:17px;position:relative;overflow:hidden;z-index:0;transition:color .3s}
+.pill::before{content:"";position:absolute;inset:0;z-index:-1;background:#fff;transform:translateX(-101%);transition:transform .5s cubic-bezier(.19,1,.22,1)}
+.pill:hover::before,.pill:focus-visible::before{transform:none}
+.pill:hover,.pill:focus-visible{color:var(--base)}
+footer{padding:150px 0 50px;position:relative}
+footer .row{width:min(86%,1260px);margin:0 auto;display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap;align-items:flex-start;position:relative;z-index:2}
+footer nav{display:grid;gap:8px;font-family:var(--en);font-size:17px}
+footer .addr{font-size:13px;line-height:2;margin-top:20px}
+.copy{width:min(86%,1260px);margin:60px auto 0;font:400 12px var(--en);position:relative;z-index:2}
+@media (max-width:800px){
+ header{padding:18px 20px}.brand{font-size:26px}
+ header nav{position:fixed;inset:0;background:var(--base);flex-direction:column;justify-content:center;align-items:center;font-size:26px;gap:26px;margin:0;display:none}
+ header nav.open{display:flex}
+ .burger{display:block;position:relative;z-index:40}
+ .sec{padding:100px 0 80px}.sub-hero{padding:150px 0 140px}
+ .policy dl>div{grid-template-columns:1fr;gap:4px}
+}
+@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.pill::before{transition:none}}
